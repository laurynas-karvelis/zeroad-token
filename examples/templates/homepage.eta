<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Zero Ad Network - publisher example</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1rem; line-height: 1.6; }
      .badge { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.85rem; }
      .subscriber { background: #e6f6ec; color: #14532d; }
      .visitor { background: #f1f1f1; color: #444; }
      .ad { border: 1px dashed #bbb; padding: 1.5rem; text-align: center; color: #777; margin: 2rem 0; }
      code { background: #f5f5f5; padding: 0.1rem 0.35rem; border-radius: 4px; }
    </style>
  </head>
  <body>
    <h1>Zero Ad Network - publisher example</h1>

    <% if (it.subscriber) { %>
      <p><span class="badge subscriber">Subscriber - <%= it.plan %></span></p>
      <p>
        This visitor holds a live subscription. The site owes them an ad-free, tracker-free page with no
        cookie consent dialog and no paywall - and gets paid a share of their subscription for the visit.
      </p>
      <h2>Premium article</h2>
      <p>The full text renders here, with no paywall and no interruption.</p>
    <% } else { %>
      <p><span class="badge visitor">Ordinary visitor</span></p>
      <p>
        No valid token on this request<% if (it.reason) { %> (<code><%= it.reason %></code>)<% } %>,
        so the site behaves exactly as it always has.
      </p>

      <div class="ad">Advertisement</div>

      <h2>Premium article</h2>
      <p>The first paragraph shows, and the rest sits behind the paywall.</p>
    <% } %>
  </body>
</html>
